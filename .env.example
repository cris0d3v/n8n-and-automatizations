# Domain configuration
DOMAIN_NAME=example.com
SUBDOMAIN=n8n

# Email used for TLS certificate registration
SSL_EMAIL=your-email@example.com

# Venezuela
GENERIC_TIMEZONE=America/Caracas

# Encryption key for n8n credentials
# Generate with: openssl rand -hex 32
N8N_ENCRYPTION_KEY=replace-with-a-generated-random-key